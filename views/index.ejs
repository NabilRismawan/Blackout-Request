<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Manajemen Pemadaman INALUM</title>
    
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="32x32" href="/logo-inalum-dashboard.png">
    <link rel="apple-touch-icon" href="/logo-inalum-dashboard.png">
    
    <!-- CSS DARI FOLDER PUBLIC -->
    <link rel="stylesheet" href="/css/style.css">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#F8FAFC', 'background-soft': '#F1F5F9', foreground: '#0F172A', muted: '#64748B', border: '#E2E8F0',
                        inalum: { blue: '#0A457F', bluehover: '#083663', green: '#009A44', red: '#E31B23' }
                    },
                    fontFamily: { sans: ['Satoshi', 'Inter', '-apple-system', 'sans-serif'] },
                    borderRadius: { '4xl': '2rem' },
                }
            }
        };
    </script>
</head>

<body class="bg-background text-foreground font-sans flex h-screen overflow-hidden">
    <!-- EFEK GRAIN -->
    <svg class="grain-overlay" aria-hidden="true"><filter id="grain"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch" /><feColorMatrix type="saturate" values="0" /></filter><rect width="100%" height="100%" filter="url(#grain)" /></svg>

    <!-- INJEKSI FILE SIDEBAR -->
    <%- include('partials/sidebar') %>

    <div class="flex-1 flex flex-col overflow-hidden w-full">
        <!-- INJEKSI FILE HEADER -->
        <%- include('partials/header') %>

        <main class="flex-1 overflow-x-hidden overflow-y-auto bg-background p-4 md:p-6 lg:p-10">
            <div id="alertNotification" class="max-w-5xl mx-auto hidden mb-6 p-4 rounded-xl text-sm text-center font-medium border"></div>

            <!-- SECTION 1: DASHBOARD OVERVIEW -->
            <section id="view-overview" class="max-w-5xl mx-auto space-y-6 hidden w-full">
                <div class="relative overflow-hidden rounded-3xl bg-inalum-blue text-white min-h-[280px] md:min-h-[380px] flex flex-col justify-between p-6 md:p-10 lg:p-12 w-full">
                    <img src="https://images.unsplash.com/photo-1693013112835-5f3128bb555f?fm=jpg&q=60&w=1600&auto=format&fit=crop" alt="" class="absolute inset-0 h-full w-full object-cover opacity-40 grayscale mix-blend-luminosity" />
                    <div class="hero-halftone absolute inset-0"></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-inalum-blue via-inalum-blue/70 to-inalum-blue/30"></div>
                    <div class="relative z-10 flex items-start justify-between">
                        <span class="inline-flex items-center gap-2 text-[10px] md:text-[11px] uppercase tracking-[0.2em] text-white/100"><span class="h-1.5 w-1.5 rounded-full bg-inalum-green animate-pulse"></span>Sistem Aktif</span>
                        <span id="heroClock" class="text-[10px] md:text-[11px] uppercase tracking-[0.2em] text-white/100 text-right max-w-[50%]"></span>
                    </div>
                    <div class="relative z-10 mt-10 md:mt-0">
                        <span class="block text-[10px] md:text-xs uppercase tracking-[0.2em] text-white/60 mb-2 md:mb-3" id="heroGreeting">Selamat Datang</span>
                        <h2 class="text-3xl md:text-5xl lg:text-6xl font-medium tracking-tight leading-[1.1]"><span id="heroTypedText"></span><span class="hero-cursor inline-block w-[2px] md:w-[3px] h-[0.85em] bg-white align-middle ml-1"></span></h2>
                        <p class="mt-3 md:mt-4 max-w-md text-xs md:text-sm text-white/70">Pantau, ajukan, dan validasi jadwal pemadaman dari satu tempat.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 w-full">
                    <div class="stat-card bg-white p-5 md:p-6 rounded-2xl border border-border transition-all hover:-translate-y-1 hover:shadow-lg"><p class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-2">Total Pengajuan</p><p class="text-3xl md:text-4xl font-medium tracking-tight text-inalum-blue" id="stat-total" data-value="0">0</p></div>
                    <div class="stat-card bg-white p-5 md:p-6 rounded-2xl border border-border transition-all hover:-translate-y-1 hover:shadow-lg"><p class="flex items-center gap-2 text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-2"><span class="h-1.5 w-1.5 rounded-full bg-amber-500 shrink-0"></span>Menunggu</p><p class="text-3xl md:text-4xl font-medium tracking-tight text-inalum-blue" id="stat-pending" data-value="0">0</p></div>
                    <div class="stat-card bg-white p-5 md:p-6 rounded-2xl border border-border transition-all hover:-translate-y-1 hover:shadow-lg"><p class="flex items-center gap-2 text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-2"><span class="h-1.5 w-1.5 rounded-full bg-inalum-green shrink-0"></span>Disetujui</p><p class="text-3xl md:text-4xl font-medium tracking-tight text-inalum-blue" id="stat-approved" data-value="0">0</p></div>
                    <div class="stat-card bg-white p-5 md:p-6 rounded-2xl border border-border transition-all hover:-translate-y-1 hover:shadow-lg"><p class="flex items-center gap-2 text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-2"><span class="h-1.5 w-1.5 rounded-full bg-inalum-red shrink-0"></span>Ditolak</p><p class="text-3xl md:text-4xl font-medium tracking-tight text-inalum-blue" id="stat-rejected" data-value="0">0</p></div>
                </div>

                <div class="bg-white rounded-2xl border border-border overflow-hidden w-full">
                    <div class="flex items-center justify-between p-4 md:p-6 border-b border-border"><h3 class="text-[10px] md:text-xs uppercase tracking-[0.2em] text-muted">Aktivitas Terbaru</h3><button onclick="showView('history')" class="text-[10px] md:text-[11px] uppercase tracking-[0.15em] text-inalum-blue font-bold hover:underline p-2 -mr-2">Lihat Semua &rarr;</button></div>
                    <div id="recentActivityList" class="divide-y divide-border"><p class="p-6 text-sm text-muted italic text-center md:text-left">Memuat aktivitas...</p></div>
                </div>
            </section>

            <!-- SECTION 2: FORM PERMOHONAN -->
            <section id="view-form" class="max-w-5xl mx-auto hidden w-full">
                <div class="bg-white p-5 md:p-8 lg:p-10 rounded-2xl md:rounded-3xl border border-border">
                    <div class="mb-6 md:mb-8 border-b border-border pb-4 md:pb-6">
                        <span class="text-[10px] md:text-xs uppercase tracking-[0.2em] text-muted">Form Baru</span>
                        <h2 class="text-2xl md:text-3xl lg:text-4xl font-medium tracking-tight mt-1 md:mt-2 text-inalum-blue">Permohonan Jadwal Pekerjaan</h2>
                    </div>
                    <form id="mainForm" onsubmit="submitForm(event)">
                        <div class="mb-8 md:mb-10 bg-background-soft p-5 md:p-6 rounded-2xl border border-border">
                            <h3 class="text-[10px] md:text-xs font-medium text-inalum-blue mb-4 md:mb-5 uppercase tracking-[0.2em] border-b border-border pb-2 md:pb-3">Informasi Pemohon</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                                <div><label class="block text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-1.5 md:mb-2">Departemen Pemohon</label><input type="text" id="form-dept" required class="w-full border border-border p-3 md:p-2.5 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>
                                <div><label class="block text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-1.5 md:mb-2">Dipersiapkan Oleh (Nama)</label><input type="text" id="form-preby" required class="w-full border border-border p-3 md:p-2.5 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>
                                <div class="col-span-1 md:col-span-2">
                                    <label class="block text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-1.5 md:mb-2">Catatan Tambahan (Remark)</label>
                                    <textarea id="form-remark" rows="2" class="w-full border border-border p-3 md:p-2.5 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors" placeholder="Ketik catatan keseluruhan pemadaman di sini (Opsional)..."></textarea>
                                </div>
                            </div>
                        </div>

                        <div id="outageRequestContainer" class="space-y-8 md:space-y-10 mb-8 md:mb-10">
                            <!-- Template Form Dinamis Outage Block -->
                            <div class="outage-block border border-border rounded-2xl p-5 md:p-8 bg-white relative mt-4 md:mt-0" data-outage="1">
                                <div class="absolute -top-3 left-4 md:left-6 bg-inalum-blue text-white text-[9px] md:text-[10px] font-medium px-3 py-1 rounded-full uppercase tracking-[0.2em] outage-label shadow-sm">Pemadaman ke-1</div>
                                <button type="button" class="remove-outage-btn hidden absolute top-4 right-4 md:top-8 md:right-8 text-inalum-red font-bold text-[10px] md:text-xs uppercase tracking-[0.15em] hover:underline p-2 bg-background-soft rounded-lg md:bg-transparent md:p-0">Hapus</button>

                                <div class="mb-5 md:mb-6 mt-4 md:mt-2"><label class="block text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-1.5 md:mb-2">Jenis Pemadaman</label><input type="text" name="jenis_pemadaman" required class="w-full border border-border p-3 md:p-2.5 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>

                                <div class="bg-background-soft p-4 md:p-5 rounded-xl border border-border mb-5 md:mb-6">
                                    <h3 class="text-[10px] md:text-xs font-medium text-inalum-blue mb-3 md:mb-4 uppercase tracking-[0.2em]">Area Pemadaman</h3>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">
                                        <div><label class="block text-[10px] md:text-[11px] uppercase tracking-[0.15em] text-muted mb-1 md:mb-1.5">Dari</label><input type="text" name="area_dari" required class="w-full border border-border p-3 md:p-2 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>
                                        <div><label class="block text-[10px] md:text-[11px] uppercase tracking-[0.15em] text-muted mb-1 md:mb-1.5">Ke</label><input type="text" name="area_ke" required class="w-full border border-border p-3 md:p-2 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-5 md:mb-6">
                                    <div class="bg-background-soft p-4 md:p-5 rounded-xl border border-border">
                                        <h3 class="flex items-center gap-2 text-[10px] md:text-[11px] font-medium text-inalum-blue mb-3 md:mb-4 uppercase tracking-[0.2em]"><span class="h-1.5 w-1.5 rounded-full bg-inalum-green"></span>Waktu Pengerjaan</h3>
                                        <div class="space-y-3">
                                            <div><label class="block text-[10px] md:text-[11px] uppercase tracking-[0.15em] text-muted mb-1 md:mb-1.5">Dari</label><input type="datetime-local" name="waktu_kerja_mulai" required class="w-full border border-border p-3 md:p-2 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>
                                            <div><label class="block text-[10px] md:text-[11px] uppercase tracking-[0.15em] text-muted mb-1 md:mb-1.5">Ke</label><input type="datetime-local" name="waktu_kerja_selesai" required class="w-full border border-border p-3 md:p-2 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>
                                        </div>
                                    </div>
                                    <div class="bg-background-soft p-4 md:p-5 rounded-xl border border-border">
                                        <h3 class="flex items-center gap-2 text-[10px] md:text-[11px] font-medium text-inalum-blue mb-3 md:mb-4 uppercase tracking-[0.2em]"><span class="h-1.5 w-1.5 rounded-full bg-inalum-red"></span>Waktu Pemadaman</h3>
                                        <div class="space-y-3">
                                            <div><label class="block text-[10px] md:text-[11px] uppercase tracking-[0.15em] text-muted mb-1 md:mb-1.5">Dari</label><input type="datetime-local" name="waktu_padam_mulai" required class="w-full border border-border p-3 md:p-2 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>
                                            <div><label class="block text-[10px] md:text-[11px] uppercase tracking-[0.15em] text-muted mb-1 md:mb-1.5">Ke</label><input type="datetime-local" name="waktu_padam_selesai" required class="w-full border border-border p-3 md:p-2 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-5 md:mb-6">
                                    <label class="block text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-2 md:mb-3">Daftar Pekerjaan</label>
                                    <div class="task-list-container space-y-2">
                                        <div class="flex items-center gap-2">
                                            <input type="text" class="task-input flex-1 border border-border p-3 md:p-2.5 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors" placeholder="Rincian pekerjaan...">
                                            <button type="button" class="add-task-btn shrink-0 bg-inalum-blue text-white w-10 h-10 md:w-9 md:h-9 rounded-full font-medium text-lg hover:bg-inalum-bluehover transition-colors shadow-sm">+</button>
                                        </div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-5 md:mb-6">
                                    <div><label class="block text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-1.5 md:mb-2">Titik Pentahanan</label><input type="text" name="titik_pentahanan" class="w-full border border-border p-3 md:p-2.5 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>
                                    <div><label class="block text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-1.5 md:mb-2">Komunikasi</label><input type="text" name="komunikasi" class="w-full border border-border p-3 md:p-2.5 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>
                                    <div><label class="block text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-1.5 md:mb-2">Kepala Pelaksana</label><input type="text" name="kepala_pelaksana" class="w-full border border-border p-3 md:p-2.5 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>
                                    <div><label class="block text-[10px] md:text-xs uppercase tracking-[0.15em] text-muted mb-1.5 md:mb-2">Keterangan Tambahan</label><input type="text" name="keterangan" class="w-full border border-border p-3 md:p-2.5 rounded-xl md:rounded-lg bg-white text-sm focus:outline-none focus:border-inalum-blue transition-colors"></div>
                                </div>

                                <div class="bg-background-soft border border-border rounded-2xl p-4 md:p-6 mt-4">
                                    <h3 class="text-[10px] md:text-xs font-medium mb-3 md:mb-4 uppercase tracking-[0.2em] text-inalum-blue">Lampiran SLD (Format PDF)</h3>
                                    <input type="file" accept="application/pdf" class="sld-upload mb-4 block w-full text-xs text-muted file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:bg-inalum-blue file:text-white file:text-[10px] md:file:text-[11px] file:uppercase file:tracking-[0.15em] cursor-pointer"/>
                                    
                                    <div class="canvas-wrapper relative border border-border rounded-xl bg-white min-h-[150px] flex items-center justify-center overflow-auto cursor-crosshair">
                                        <span class="canvas-placeholder text-muted text-[10px] md:text-xs p-4 text-center">Preview PDF akan muncul di sini...<br><span class="text-[9px] mt-1 block opacity-70">Gunakan file PDF 1 halaman</span></span>
                                        <canvas class="sld-canvas hidden"></canvas>
                                    </div>
                                    
                                    <div class="canvas-controls hidden mt-4 flex flex-wrap gap-2 md:gap-3">
                                        <button type="button" class="tool-btn bg-inalum-blue text-white px-4 md:px-5 py-2 md:py-1.5 rounded-full text-[10px] md:text-[11px] uppercase tracking-[0.15em] font-medium transition-colors border border-inalum-blue shadow-sm" data-tool="highlight">Highlight</button>
                                        <button type="button" class="tool-btn bg-white text-foreground px-4 md:px-5 py-2 md:py-1.5 rounded-full text-[10px] md:text-[11px] uppercase tracking-[0.15em] font-medium transition-colors border border-border shadow-sm" data-tool="draw">Coret/Pen</button>
                                        <button type="button" class="tool-btn bg-white text-foreground px-4 md:px-5 py-2 md:py-1.5 rounded-full text-[10px] md:text-[11px] uppercase tracking-[0.15em] font-medium transition-colors border border-border shadow-sm" data-tool="text">Teks</button>
                                        <div class="w-full md:w-px h-px md:h-auto bg-border my-1 md:my-1 md:mx-1 hidden md:block"></div>
                                        <button type="button" class="undo-highlight-btn bg-white border border-border text-foreground px-4 py-2 md:py-1.5 rounded-full text-[10px] md:text-[11px] uppercase tracking-[0.15em] font-medium hover:bg-gray-100 transition-colors shadow-sm ml-auto md:ml-0">Undo</button>
                                        <button type="button" class="clear-highlight-btn bg-white border border-border text-inalum-red px-4 py-2 md:py-1.5 rounded-full text-[10px] md:text-[11px] uppercase tracking-[0.15em] font-medium hover:bg-inalum-red hover:text-white hover:border-inalum-red transition-colors shadow-sm">Clear All</button>
                                    </div>
                                    <input type="hidden" class="sld-hidden-data">
                                </div>
                            </div>
                        </div>

                        <div class="mb-8 md:mb-10"><button type="button" id="addOutageBtn" class="w-full border-2 border-dashed border-border bg-background-soft text-inalum-blue p-4 md:p-5 rounded-2xl md:rounded-3xl font-medium uppercase tracking-[0.15em] text-[10px] md:text-xs hover:border-inalum-blue hover:bg-white transition-colors">+ Tambah Request Pemadaman Selanjutnya</button></div>
                        <div class="flex justify-end"><button type="submit" class="w-full md:w-auto bg-inalum-blue text-white px-6 md:px-8 py-3.5 md:py-3 rounded-full font-medium uppercase tracking-[0.15em] text-[10px] md:text-xs hover:bg-inalum-bluehover transition-colors shadow-lg">Simpan Semua Jadwal</button></div>
                    </form>
                </div>
            </section>

            <!-- SECTION 3: HISTORI PENGAJUAN -->
            <section id="view-history" class="max-w-5xl mx-auto hidden space-y-4 md:space-y-6 w-full">
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                    <div><h2 class="text-2xl md:text-3xl lg:text-4xl font-medium tracking-tight text-inalum-blue">Histori Pengajuan</h2><span class="text-[10px] md:text-xs uppercase tracking-[0.2em] text-muted">Arsip Keseluruhan</span></div>
                    <div class="flex items-center gap-2 bg-white border border-border p-1.5 rounded-xl shadow-sm shrink-0">
                        <span class="pl-2 text-muted"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg></span>
                        <input type="date" id="historyDateFilter" onchange="loadDataFromServer()" class="bg-transparent text-xs text-foreground focus:outline-none cursor-pointer">
                        <button onclick="document.getElementById('historyDateFilter').value=''; loadDataFromServer()" class="px-2 py-1 bg-background-soft text-[10px] uppercase tracking-wider rounded-lg hover:bg-border transition-colors">Reset</button>
                    </div>
                </div>
                <div class="bg-white rounded-2xl md:rounded-3xl border border-border overflow-hidden shadow-sm">
                    <div class="overflow-x-auto w-full">
                        <table class="w-full text-left border-collapse min-w-[800px]">
                            <thead>
                                <tr class="text-muted text-[10px] md:text-[11px] uppercase tracking-[0.15em] border-b border-border bg-background-soft/50">
                                    <th class="p-3 md:p-4 font-medium whitespace-nowrap">ID</th>
                                    <th class="p-3 md:p-4 font-medium whitespace-nowrap">Pemohon</th>
                                    <th class="p-3 md:p-4 font-medium whitespace-nowrap">Departemen</th>
                                    <th class="p-3 md:p-4 font-medium whitespace-nowrap">Tanggal Pengajuan</th>
                                    <th class="p-3 md:p-4 font-medium whitespace-nowrap">Status</th>
                                    <th class="p-3 md:p-4 font-medium whitespace-nowrap text-right">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="historyTableBody" class="text-xs md:text-sm"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- SECTION 4: PANEL VALIDASI APPROVAL -->
            <section id="view-approval" class="max-w-5xl mx-auto hidden space-y-4 md:space-y-6 w-full">
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                    <div><h2 class="text-2xl md:text-3xl lg:text-4xl font-medium tracking-tight text-inalum-blue" id="approvalPanelTitle">Panel Validasi Pengajuan</h2><span class="text-[10px] md:text-xs uppercase tracking-[0.2em] text-muted">Aksi Diperlukan</span></div>
                    <div class="flex items-center gap-2 bg-white border border-border p-1.5 rounded-xl shadow-sm shrink-0">
                        <span class="pl-2 text-muted"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg></span>
                        <input type="date" id="approvalDateFilter" onchange="loadDataFromServer()" class="bg-transparent text-xs text-foreground focus:outline-none cursor-pointer">
                        <button onclick="document.getElementById('approvalDateFilter').value=''; loadDataFromServer()" class="px-2 py-1 bg-background-soft text-[10px] uppercase tracking-wider rounded-lg hover:bg-border transition-colors">Reset</button>
                    </div>
                </div>
                <div class="bg-white rounded-2xl md:rounded-3xl border border-border overflow-hidden shadow-sm">
                    <div class="overflow-x-auto w-full">
                        <table class="w-full text-left border-collapse min-w-[900px]">
                            <thead>
                                <tr class="text-muted text-[10px] md:text-[11px] uppercase tracking-[0.15em] border-b border-border bg-background-soft/50">
