<!-- MODAL DETAIL -->
<div id="detailModal" class="fixed inset-0 bg-foreground/60 backdrop-blur-sm z-50 hidden flex flex-col items-center justify-end md:justify-center p-0 md:p-4 transition-all">
    <div class="bg-background w-full h-[90vh] md:h-auto md:max-h-[90vh] md:max-w-5xl rounded-t-3xl md:rounded-3xl border border-border flex flex-col overflow-hidden shadow-2xl animate-[fade-up_0.3s_ease-out]">
        <div class="w-full flex justify-center pt-3 pb-1 md:hidden bg-white"><div class="w-12 h-1.5 bg-border rounded-full"></div></div>
        <div class="p-4 md:p-6 border-b border-border flex justify-between items-center bg-white shrink-0">
            <h3 class="text-lg md:text-xl font-medium tracking-tight text-inalum-blue truncate mr-4" id="modalTitle">Detail Permohonan</h3>
            <button onclick="closeDetailModal()" class="text-muted hover:text-inalum-red text-3xl leading-none transition-colors p-2 -m-2" aria-label="Tutup">&times;</button>
        </div>
        <div class="p-4 md:p-8 overflow-y-auto flex-1 bg-background overscroll-contain" id="modalContent"></div>
        <div class="p-4 md:p-5 border-t border-border flex justify-end gap-3 bg-white shrink-0">
            <button id="btnPrintPDF" onclick="window.print()" class="hidden w-full md:w-auto bg-inalum-green text-white px-6 py-3 md:py-2.5 rounded-full font-medium uppercase tracking-[0.15em] text-[10px] md:text-xs hover:bg-inalum-green/90 transition-colors shadow-sm">Cetak Surat Balasan POP (PDF)</button>
            <button onclick="closeDetailModal()" class="w-full md:w-auto border border-border text-foreground px-6 py-3 md:py-2.5 rounded-full font-medium uppercase tracking-[0.15em] text-[10px] md:text-xs hover:bg-gray-100 transition-colors">Tutup Dokumen</button>
        </div>
    </div>
</div>

<!-- KONTAINER TEMPLATE CETAK RESMI -->
<div id="printTemplateContainer" class="hidden"></div>

<!-- MODAL PROSES POP (Divisi POP) -->
<div id="popProcessModal" class="fixed inset-0 bg-foreground/60 backdrop-blur-sm z-[60] hidden flex flex-col items-center justify-center p-4 transition-all">
    <div class="bg-white w-full max-w-lg rounded-3xl p-6 md:p-8 shadow-2xl animate-[fade-up_0.2s_ease-out]">
        <h3 class="text-xl md:text-2xl font-bold text-inalum-blue mb-2">Proses Dokumen (Divisi POP)</h3>
        <p class="text-xs text-gray-500 mb-6">Lengkapi data konfirmasi sebelum menyetujui dokumen ini.</p>
        
        <form id="popProcessForm" onsubmit="submitPopProcess(event)">
            <input type="hidden" id="pop_req_id">
            <div class="space-y-4">
                <div>
                    <label class="block text-[10px] md:text-xs uppercase tracking-[0.15em] text-gray-500 mb-1.5">Tujuan Surat (To:)</label>
                    <input type="text" id="pop_surat_to" required class="w-full border border-border p-3 rounded-xl text-sm focus:outline-none focus:border-inalum-blue" placeholder="Contoh: PMN, POT, PME">
                </div>
            </div>
            <div class="mt-8 flex justify-end gap-3">
                <button type="button" onclick="closePopProcessModal()" class="px-5 py-2.5 border border-border rounded-full text-[10px] md:text-xs font-bold uppercase tracking-[0.15em] text-gray-500 hover:bg-gray-100 transition-colors">Batal</button>
                <button type="submit" class="px-6 py-2.5 bg-inalum-blue hover:bg-inalum-bluehover text-white rounded-full text-[10px] md:text-xs font-bold uppercase tracking-[0.15em] transition-colors shadow-sm">Proses & Kirim</button>
            </div>
        </form>
    </div>
</div>