<!-- BAGIAN MOBILE DRAWER -->
<!-- ============================================== -->
<div id="drawerOverlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden backdrop-blur-sm transition-opacity opacity-0" onclick="toggleMobileMenu()"></div>

<aside id="mobileDrawer" class="fixed inset-y-0 left-0 w-3/4 max-w-sm bg-inalum-blue text-white flex flex-col z-50 transform -translate-x-full lg:hidden">
    <div class="h-16 flex items-center justify-between px-6 border-b border-white/10">
        <div class="flex items-center gap-3"><img src="/logo-inalum-dashboard.png" alt="INALUM" class="h-8 w-auto"><h1 class="text-xs font-medium tracking-[0.2em] uppercase leading-tight">Menu Navigasi</h1></div>
        <button onclick="toggleMobileMenu()" class="text-white/50 hover:text-white p-2 -mr-2 text-xl">&times;</button>
    </div>
    <nav id="mobile-nav-container" class="flex-1 px-4 py-6 space-y-2 overflow-y-auto"></nav>
    <div class="p-6 border-t border-white/10"><button id="logoutBtnMobile" class="w-full border border-white/20 text-white py-3 rounded-full transition-colors text-xs uppercase tracking-[0.15em] font-medium hover:bg-white hover:text-inalum-blue">Keluar (Logout)</button></div>
</aside>